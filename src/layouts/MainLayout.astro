---
import Footer from '../components/Footer.astro';
import '/src/styles/global.css';
import LogoIco from "../assets/logo.ico"

import logoSiteAlt from "../assets/logo-site-alt.webp"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8"> 
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Discover Taylor Violet Ross, Canadian-based forensic artist and multidisciplinary creative blending science, identity, and art through traditional, digital, and forensic practices."/>
		<meta name="generator" content={Astro.generator} />
		<title>Taylor Violet Ross | Forensic Artist</title>
		<script src="https://kit.fontawesome.com/9eb3f8336e.js" crossorigin="anonymous"></script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="icon" href={LogoIco}>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="/styles/global.css" />
		<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@100;300;400;500;700;800;900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:title" content="Taylor Violet Ross | Forensic Artist" />
		<meta property="og:description" content="Taylor Violet Ross; Canadian based forensic artist and multidisciplinary creative blending science and art through traditional, digital, and forensic practices." />
		<meta property="og:image" content={logoSiteAlt.src} />
	</head>	
	<body>
		<slot name="header"/>
		<slot />
	</body>
	<Footer/>
</html>
