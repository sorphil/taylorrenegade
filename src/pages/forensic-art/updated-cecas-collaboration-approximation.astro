---

import Header from '../../components/Header.astro';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import MainImage from '../../assets/fa-images/cecasnew/cecasnew.webp'
const images = await Astro.glob("/src/assets/fa-images/cecasnew/images/*").then(files => {
  return files.map(file => file.default);
});

---

    <ProjectLayout 
        type="fa"
        title=`Woman From Leith (CECAS Collaboration; 2025 Update)`
        year=`2025`
        subtitle=`Materials: Geomagic Freeform, Procreate, Oil Paint`
        text1=`2025 update to a self-directed project created as part of my MSc Forensic Art & Facial Imaging course, in 
        collaboration with the City Of Edinburgh Council Archeological Service (CECAS). I was provided a a 3D scan of a 
        Medieval skull from Leith, Edinburgh and decided to do a digital 3D Craniofacial Approximation. 
        This project was mainly done in GeoMagic FreeForm, and then a final texturing was done in 2D digitally overtop of 
        the reconstruction within Procreate, as well as another traditional painting done with oil paint using the 
        3D reconstruction as a reference.`
        mainImage = {MainImage}
        images={images}
        gridType=2
        />



