---
import ProjectItem from '/src/components/projects/ProjectItem.astro';
import Header from '/src/components/Header.astro';
import MainLayout from '/src/layouts/MainLayout.astro';
import CranApproxTile from "/src/assets/fa-images/cranapprox/cranapprox-tile.webp"
import MastersTile from "/src/assets/fa-images/masters/masters-00.webp"
import CECASTile from "/src/assets/fa-images/cecas/cecas-00.webp"
import CECASNewTile from "/src/assets/fa-images/cecasnew/cecasnew.webp"
import GiraffeTile from "/src/assets/fa-images/giraffe/giraffe-tile.webp"
import CompositeTile from "/src/assets/fa-images/composite/composite-tile.webp"
import FFSTile from "/src/assets/fa-images/ffs/ffs-tile.webp"
import ScientificTile from "/src/assets/fa-images/scientific/scientific-tile.webp"
import AgeProgChildTile from "/src/assets/fa-images/ageprogchild/ageprogchild-tile.webp"
import AgeProgAdultTile from "/src/assets/fa-images/ageprogadult/ageprogadult-tile.webp"
import FAImageHead from '/src/assets/fa-images/fa-head.webp'
import { Image } from 'astro:assets';
---

<MainLayout >
    <Header active="FORENSIC ART" slot="header"/>
    <div class="forensic-art-head-container">
        <Image src={FAImageHead} alt="Collage of forensic art work containing text 'Forensic Art' as the title." class="forensic-art-head-image" loading="eager"/>
        <h1 class="forensic-art-head-text">
            FORENSIC ART
        </h1>
    </div>
    <div class="forensic-art-text">
        This page includes examples of Forensic Art projects that are available for public viewing. I am trained in the following: <br> 
        <strong>Craniofacial Approximation, Artificial Age Progression, Composite Sketching (& Eyewitness Cognitive Interviewing), <br> 
        Postmortem Depiction, Craniofacial Superimposition, Facial Image Comparison.</strong>
        <br/><br>Examples of each are available upon request by emailing taylorrenegade@outlook.com, but some are not suitable for public viewing. 
    </div>
	<main class="forensic-art-container">
   
        <ProjectItem
            imageSrc = {MastersTile} 
            name="Master's Forensic Art Dissertation"
            altText="Taylor Ross standing beside her dissertation work."
            link="/forensic-art/masters-forensic-art-dissertation"
            loading="eager"
        />  
         <ProjectItem
        imageSrc = {CECASNewTile} 
        name="CECAS Approximation; Updated (2025)"
        altText="A physical painting containing an illustration of a woman approximated from a skull of a woman from Leith, Edinburgh."
        link="/forensic-art/updated-cecas-collaboration-approximation"
        loading="eager"
    />  
        <ProjectItem
        imageSrc = {CranApproxTile} 
        name="3D Manual Craniofacial Approximation"
        altText="Taylor Ross standing beside her dissertation work."
        link="/forensic-art/3d-manual-craniofacial-approximation"
        loading="eager"
    />  
     <ProjectItem
            imageSrc = {GiraffeTile} 
            name="Giraffe Skull Reconstruction"
            altText="A giraffe ecorche reconstructed from a skull exhibiting the different layers of muscle, fat and bones underneath its skin."
            link="/forensic-art/giraffe-skull-reconstruction"
            loading="eager"
        />
        <ProjectItem
            imageSrc = {CECASTile} 
            name="CECAS Approximation (2024)"
            altText="An illustration of a woman approximated from a skull of a woman from Leith, Edinburgh."
            link="/forensic-art/cecas-collaboration-approximation"
            loading="eager"
        />  
       
        <ProjectItem
            imageSrc = {CompositeTile} 
            name="Collection of Composite Sketches"
            altText="A forensic drawing or sketch of a man."
            link="/forensic-art/collection-of-composite-sketches"
            loading="late"
        />  
        <ProjectItem
            imageSrc = {FFSTile} 
            name="FFS Wax Ecorche"
            altText="A sculpture/ecorche of a woman undergoing facial feminization surgery exhibiting the different areas of surgery."
            link="/forensic-art/ffs-wax-ecorche"
            loading="late"
        />  
        <ProjectItem
            imageSrc = {ScientificTile} 
            name="Collection of Scientific Illustrations"
            altText="A labelled diagram or illustration of a left hand."
            link="/forensic-art/collection-of-scientific-illustrations"
            loading="late"
        />
        <ProjectItem
            imageSrc = {AgeProgChildTile} 
            name="Artificial Age Progression: Child"
            altText="An illustration of a child."
            link="/forensic-art/artificial-age-progression-child"
            loading="late"
        />  
        <ProjectItem
            imageSrc = {AgeProgAdultTile} 
            name="Artificial Age Progression: Adult"
            altText="A man artificially aged up, with each illustration placed side by side to show the differences between the different ages."
            link="/forensic-art/artificial-age-progression-adult"
            loading="late"
        />
        
      
	</main>
	
</MainLayout>

<style>

.forensic-art-head-container
 {
	width:59.5rem;
	height: auto;
	position:relative;

    margin:2rem 0 1rem 0;

 }
 
 .forensic-art-head-text
 {
	position: absolute;
	top:35%;
	left: 50%;
	transform: translate(-50%, -50%);
	color: white;
	font-size: 3.5rem;
	text-decoration: none;
	font-weight: bolder;
	font-family: "Roboto", serif;
        font-optical-sizing: auto;
        font-weight: 700;
 }
 .forensic-art-head-image
 {
    filter: brightness(40%);
     width:100%; 
     height: auto;
 }

    .forensic-art-title
    {
        padding-top:1rem;
        text-align: center; 

    }
    .forensic-art-text
    {
        width:59.5rem; 
        text-align: center; 
        padding-bottom:2rem;
    }
    .forensic-art-container
    {
        text-align: center;
        width: 65rem;
        padding:2rem 1rem 2rem 1rem;
        display: grid;
        box-sizing: border-box;
        grid-template-columns: repeat(3, 1fr); 
       
   
    }
 
    @media only screen and (max-width: 500px) 
    {
        
        .forensic-art-title
        {
            padding-top:1rem;
            text-align: center; 

        }
        .forensic-art-head-container
        {
            width:100%;
            height: auto;
            position:relative;

            margin:2rem 0 1rem 0;
        }
        .forensic-art-head-text
        {
            font-size: 4rem;;
        }
        .forensic-art-text
        {
            width:100%;
            font-size:2rem;
            padding:0 0.75rem 0 0.75rem;
            box-sizing: border-box;

        }
        .forensic-art-container
        {
            text-align: center;
            width: 100%;
            padding:2rem 1rem 2rem 1rem;
            display: inline-grid;
            box-sizing: border-box;
            grid-template-columns: repeat(1, 1fr); 
            justify-items: center;
        
    
        }
 
    }
</style>