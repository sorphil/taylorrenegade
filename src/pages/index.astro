---
import MainLayout from '/src/layouts/MainLayout.astro';
import Header from '/src/components/Header.astro';

import FAImageLink from '/src/assets/home/fa-img.webp'
import OWImageLink from '/src/assets/home/ow-img.webp'
import COMImageLink from '/src/assets/home/com-img.webp'
import Image from 'astro/components/Image.astro';
---


<MainLayout>
	<Header active="HOME" slot="header"/>
	<main>
		<section class ="index-about">
			<a class="index-link"  href="/forensic-art/">
				<Image width="1550" height="620" src={FAImageLink} alt="Collage of forensic art and projects with the text Forensic Art serving as a link to the page"  class="index-link-image"/>
				<div class="index-link-text">
					FORENSIC ART
				</div>
			</a>
			<a class="index-link"  href="/other-works/">
				<Image width="1550" height="620" src={OWImageLink} alt="Collage of various artworks using mixed media  with the text Other Works serving as a link to the page"  class="index-link-image"/>
				<div class="index-link-text">
					OTHER WORKS
				</div>
			</a>
			<a class="index-link" href="/commissions/">
				<Image width="1550" height="620" src={COMImageLink} alt="Collage of painted portraits with the text Commissions serving as a link to the page" class="index-link-image"/>
				<div class="index-link-text">
					COMMISSIONS
				</div>
			</a>
		</section>
	</main>
</MainLayout>

<style>
 .index-about
 {
	display: flex;
	justify-content: center;
	flex-direction: column;
 }
 .index-link
 {
	width:100%;
	height: auto;
	position:relative;

	&:hover
	{
		text-decoration: underline;
		cursor: pointer;
		opacity: 90%;
	}

 }
 
 .index-link-image
 {
	filter: brightness(40%);
	width:100%;
	height: auto;
 }
 .index-link-text
 {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	color: white;
	font-size: 5rem;
	text-decoration: none;
	font-weight: bolder;
	font-family: "Roboto", serif;
        font-optical-sizing: auto;
        font-weight: 700;
 }
</style>