---

import Header from '../../components/Header.astro';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import MainImage from '../../assets/ow-images/disintegration/disintegration-tile.webp'
const images = await Astro.glob("/src/assets/ow-images/disintegration/images/*").then(files => {
  return files.map(file => file.default);
});

---

    <ProjectLayout 
        type="ow"
        title=`Disintegration`
        year=`2025`
        subtitle=`Materials: Oil Paint, Electrical Wire, Plaster Wrap, Masking Tape on 20” Diameter Circular Canvas `
        text1=`Sculptural electrical wire portrait, overlaid with oil painted skin sections on raised plaster wrap.`
        mainImage={MainImage}
        images={images}
        gridType=2
        />



