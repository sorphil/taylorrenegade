---

import Header from '/src/components/Header.astro';
import ProjectLayout from '/src/layouts/ProjectLayout.astro';
import MainImage from '/src/assets/ow-images/parasitism/parasitism-tile.webp'
const images = await Astro.glob("/src/assets/ow-images/parasitism/images/*").then(files => {
  return files.map(file => file.default);
});

---

    <ProjectLayout 
        type="ow"
        title=`PARASITISM (Part 1/5) `
        year=`2025`
        subtitle=`Materials: Oil Paint, Electrical Wire, Plaster Wrap, Masking Tape on 24” Diameter Circular Canvas`
        text1=`A piece that explores themes of identity, illness and trauma through a wire sculpture mimicking underlying muscular anatomy. 
        Part of a larger series in production, stay tuned for more!`
        mainImage={MainImage}
        images={images}
        gridType=2
        />



