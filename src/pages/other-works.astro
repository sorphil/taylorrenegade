---
import ProjectItem from '/src/components/projects/ProjectItem.astro';
import Header from '/src/components/Header.astro';
import MainLayout from '/src/layouts/MainLayout.astro';
import AmensalismTile from "/src/assets/ow-images/amensalism/amensalism-tile.webp"
import ParasitismTile from "/src/assets/ow-images/parasitism/parasitism-tile.webp"
import EcorcheTile from "/src/assets/ow-images/ecorche/ecorche-tile.webp"
import PortraitsTile from "/src/assets/ow-images/portraits/portraits-tile.webp"
import ChemicalTile from "/src/assets/ow-images/chemical/chemical-tile.webp"
import MemoriesTile from "/src/assets/ow-images/memories/memories-tile.webp"
import AfterTile from "/src/assets/ow-images/after/after-tile.webp"
import LifeDrawingsTile from "/src/assets/ow-images/lifedrawings/lifedrawings-tile.webp"
import TBDATETile from "/src/assets/ow-images/tbdate/tbdate-tile.webp"
import OWImageHead from '/src/assets/ow-images/ow-head.webp'
import { Image } from 'astro:assets';
---

<MainLayout>
    <Header active=`OTHER WORKS` slot="header"/>
    <div class="other-works-head-container">
        <Image alt="Collage of various artwork containing text 'Other Work' as the title." src={OWImageHead} class="other-works-head-image" loading="eager" />
        <h1 class="other-works-head-text">
            OTHER WORKS
        </h1>
    </div>
    <div class="other-works-text">
        This page showcases a selection of my artistic works beyond forensic art, including pieces created during my undergraduate studies in Life Studies. 
        My work explores human anatomy and experience with expressive compositions through various mediums and techniques. 
    </div>
	<main class="other-works-container">
        <ProjectItem
            imageSrc = {AmensalismTile} 
            name="Amensalism"
            altText="An image of a woman covered and restricted by wires resembling muscles"
            link="/other-works/amensalism"
            loading="eager"
        />  
         <ProjectItem
            imageSrc = {ParasitismTile} 
            name="Parasitism"
            altText="An image of a woman covered and restricted by wires resembling muscles"
            link="/other-works/parasitism"
            loading="eager"
        />  
        <ProjectItem
            imageSrc = {EcorcheTile} 
            name="Ecorche"
            altText="An image of a woman displaying the inner musculature structure on a section of her face"
            link="/other-works/ecorche"
            loading="eager"
        />  
        <ProjectItem
            imageSrc = {PortraitsTile} 
            name="Collection of Portraits"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/collection-of-portraits"
            loading="eager"
        />  
        <ProjectItem
            imageSrc = {ChemicalTile} 
            name="Chemical Existence"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/chemical-existence"
            loading="lazy"
        /> 
        <ProjectItem
            imageSrc = {MemoriesTile} 
            name="Memories That Breathe"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/memories-that-breathe"
            loading="lazy"
        /> 
        <ProjectItem
            imageSrc = {AfterTile} 
            name="After"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/after"
            loading="lazy"
            /> 
        <ProjectItem
            imageSrc = {LifeDrawingsTile} 
            name="A Collection of Life Drawings"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/collection-of-life-drawings"
            loading="lazy"
            /> 
        <ProjectItem
            imageSrc = {TBDATETile} 
            name="They Both Die at The End"
            altText="An image containing an illustrated woman approximated from a skull of a woman from Leith, Edinburgh"
            link="/other-works/they-both-die-at-the-end"
            loading="lazy"
            /> 
      
	</main>
	
</MainLayout>

<style>

.other-works-head-container
 {
	width:59.5rem;
	height: auto;
	position:relative;

    margin:2rem 0 1rem 0;

 }
 
 .other-works-head-image
 {
	filter: brightness(40%);
	width:100%;
	height: auto;
 }
 .other-works-head-text
 {
	position: absolute;

	top: 35%;
	left: 50%;
	transform: translate(-50%, -50%);
	color: white;
	font-size: 3.5rem;
	text-decoration: none;
	font-weight: bolder;
	font-family: "Roboto", serif;
        font-optical-sizing: auto;
        font-weight: 700;
 }

   
    .other-works-text
    {
        width:59.5rem; 
        text-align: center; 
        padding-bottom:2rem;
    }
    .other-works-container
    {
        text-align: center;
        width: 65rem;
        padding:2rem 1rem 2rem 1rem;
        display: grid;
        box-sizing: border-box;
        grid-template-columns: repeat(3, 1fr); 
       
   
    }
 
    @media only screen and (max-width: 500px) 
    {
        
        .other-works-title
        {
            padding-top:1rem;
            text-align: center; 

        }
        .other-works-head-container
        {
            width:100%;
            height: auto;
            position:relative;

            margin:2rem 0 1rem 0;
        }
        .other-works-head-text
        {
            font-size: 4rem;;
        }
        .other-works-text
        {
            width:100%;
            font-size:2rem;
            padding:0 0.75rem 0 0.75rem;
            box-sizing: border-box;

        }
        .other-works-container
        {
            text-align: center;
            width: 100%;
            padding:2rem 1rem 2rem 1rem;
            display: inline-grid;
            box-sizing: border-box;
            grid-template-columns: repeat(1, 1fr); 
            justify-items: center;
        
    
        }
 
    }

</style>